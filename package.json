    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "echo 'test:e2e is not configured yet \u2014 Playwright arrives with issue #13' && exit 1",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run test",
    "clean": "rm -rf .next out coverage",
    "ui:add": "pnpm dlx shadcn@latest add",
    "ui:diff": "pnpm dlx shadcn@latest diff"
