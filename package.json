{
  "name": "chemlab",
  "version": "0.8.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "bundle:check": "tsx scripts/bundle-check.ts",
    "start": "next start",
    "env:check": "tsx scripts/env-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:check": "tsx scripts/db-check.ts",
    "db:seed": "tsx scripts/seed.ts",
    "rollup": "tsx scripts/rollup.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "pages:check": "tsx scripts/pages-check.ts",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "db:local:start": "pg_ctlcluster 16 main start || true",
    "db:local:stop": "pg_ctlcluster 16 main stop || true",
    "db:local:reset": "tsx scripts/db-local-reset.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:all": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run pages:check && pnpm run test",
    "clean": "rm -rf .next out coverage",
    "ui:add": "pnpm dlx shadcn@latest add",
    "ui:diff": "pnpm dlx shadcn@latest diff"
  },
